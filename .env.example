# StreamFlix — copie para .env e preencha antes de subir (nunca commite o .env).
DB_NAME=streamflix
DB_USER=streamflix
DB_PASS=troque_esta_senha_do_banco
DB_ROOT_PASS=troque_esta_senha_root
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque_esta_senha_do_admin
# Token de acesso do Mercado Pago (opcional; pode configurar depois no admin).
MP_ACCESS_TOKEN=
# URL publica do site (opcional; sem ela o site usa o Host da requisicao).
SITE_URL=
